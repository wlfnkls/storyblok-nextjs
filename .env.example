# Storyblok → Settings → Access Tokens: token with access level "Public" (published content)
STORYBLOK_PUBLIC_TOKEN=

# Storyblok → Settings → Access Tokens: token with access level "Preview" (draft content).
# Also verifies the signed Visual Editor preview links in app/api/draft/route.ts.
STORYBLOK_PREVIEW_TOKEN=

# Storyblok → Settings → General → Space ID. Used by the app and the Storyblok CLI (storyblok.config.ts).
STORYBLOK_SPACE_ID=

# Any long random string (e.g. `openssl rand -hex 32`); enter the same value as the webhook secret in Storyblok.
STORYBLOK_WEBHOOK_SECRET=
